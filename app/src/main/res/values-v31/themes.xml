<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash screen (the app icon on a solid colour) and
         ignores windowBackground for it, so its colour is set separately. -->
    <style name="Theme.Showdist" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowSplashScreenBackground">@color/black</item>
    </style>
</resources>
